<section id="contact" class="section contact">
  <div class="container contact__grid">
    <div>
      <h2>{{ block.get('heading') }}</h2>
      {% if block.get('intro') %}<p class="muted">{{ block.get('intro') }}</p>{% endif %}
      <ul class="facts">
        {% if block.get('phone') %}<li><span class="muted">Phone</span><a href="tel:{{ block.get('phone')|tel }}">{{ block.get('phone')|tel }}</a></li>{% endif %}
        {% if block.get('email') %}<li><span class="muted">Email</span><a href="mailto:{{ block.get('email') }}">{{ block.get('email') }}</a></li>{% endif %}
        {% if block.get('address') or block.get('city') %}<li><span class="muted">Address</span><span>{{ block.get('address') or '' }}{% if block.get('address') and block.get('city') %}, {% endif %}{{ block.get('city') or '' }}{% if block.get('province') %}, {{ block.get('province') }}{% endif %}</span></li>{% endif %}
        {% if block.get('facebook') %}<li><span class="muted">Facebook</span><a href="{{ block.get('facebook') }}" rel="noopener" target="_blank">Visit our page</a></li>{% endif %}
      </ul>
    </div>
    {% if block.get('show_form') %}
    <form class="card contact-form" method="post" action="{{ api_url }}/api/v1/public/sites/{{ subdomain }}/contact" data-contact-form>
      <label>Name<input name="name" required maxlength="200" autocomplete="name"></label>
      <label>Email<input name="email" type="email" maxlength="320" autocomplete="email"></label>
      <label>Phone<input name="phone" type="tel" maxlength="32" autocomplete="tel"></label>
      <label>Message<textarea name="message" required maxlength="2000" rows="4"></textarea></label>
      <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
      <button class="btn" type="submit">Send message</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
    {% endif %}
  </div>
</section>
