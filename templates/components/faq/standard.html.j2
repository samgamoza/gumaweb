<section id="faq" class="section faq">
  <div class="container container--narrow">
    <h2>{{ block.get('heading') }}</h2>
    {% for item in block.get('items', []) %}
    <details class="accordion">
      <summary>{{ item.get('question') }}</summary>
      <p>{{ item.get('answer') }}</p>
    </details>
    {% endfor %}
  </div>
</section>
