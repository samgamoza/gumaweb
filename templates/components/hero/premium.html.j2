{% set image = block.get('image') %}
<section id="hero" class="section hero hero--premium{% if image %} has-image{% endif %}"{% if image %} style="background-image: linear-gradient(100deg, color-mix(in srgb, var(--color-accent) 92%, transparent) 0%, color-mix(in srgb, var(--color-accent) 55%, transparent) 100%), url('{{ root }}{{ image.get('path') }}')"{% endif %}>
  <div class="container hero__inner">
    <p class="eyebrow">{{ business.name }}</p>
    <h1 class="display">{{ block.get('headline') }}</h1>
    <p class="lead">{{ block.get('subheadline') }}</p>
    <div class="actions">
      <a class="btn btn--light" href="{{ link(block.get('cta_target')) }}">{{ block.get('cta_label') }}</a>
      {% if business.city %}<span class="hero__meta">{{ business.city }}{% if business.province %}, {{ business.province }}{% endif %}</span>{% endif %}
    </div>
  </div>
</section>
