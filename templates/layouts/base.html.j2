<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  {% if seo.get('keywords') %}<meta name="keywords" content="{{ (seo.keywords + seo.get('local_keywords', []))|join(', ') }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  {% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta name="generator" content="GumaWeb">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23334155'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="{{ root }}assets/site.css">
  <style>{{ css_vars }}</style>
  {% for schema in schema_blocks %}
  <script type="application/ld+json">{{ schema }}</script>
  {% endfor %}
</head>
<body>
  {% if claim_banner %}
  <div class="claim-banner" role="region" aria-label="Claim this website">
    <div class="container claim-banner__inner">
      <p><strong>Own this business?</strong> Claim this website and manage it for free.
        <span class="claim-banner__note">Created by GumaWeb from public business information.</span></p>
      <a class="btn btn--light btn--small" href="{{ claim_url }}" data-track="claim_banner_click">Claim this website</a>
    </div>
  </div>
  {% endif %}

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="{{ root }}">{{ business.name }}</a>
      <nav aria-label="Main navigation">
        <ul class="nav">
          {% for p in pages %}
          <li><a href="{{ root }}{{ p.path }}"{% if p.slug == page.slug %} aria-current="page"{% endif %}>{{ p.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% if business.phone %}<a class="btn btn--small header-call" href="tel:{{ business.phone|tel }}">Call</a>{% endif %}
    </div>
  </header>

  <main id="main">
    {% for section_html in sections_html %}
    {{ section_html }}
    {% endfor %}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <div>
        <p class="brand">{{ business.name }}</p>
        <p class="muted">{{ business.industry_label }}{% if business.city %} &middot; {{ business.city }}{% if business.province %}, {{ business.province }}{% endif %}{% endif %}</p>
      </div>
      <div class="site-footer__contact">
        {% if business.phone %}<p><a href="tel:{{ business.phone|tel }}">{{ business.phone|tel }}</a></p>{% endif %}
        {% if business.email %}<p><a href="mailto:{{ business.email }}">{{ business.email }}</a></p>{% endif %}
        {% if business.facebook %}<p><a href="{{ business.facebook }}" rel="noopener" target="_blank">Facebook</a></p>{% endif %}
      </div>
    </div>
    <div class="container site-footer__legal muted">
      <p>&copy; {{ year }} {{ business.name }}. Website by <a href="https://gumaweb.io" rel="noopener">GumaWeb</a>.</p>
    </div>
  </footer>

  <script>
  (function () {
    var endpoint = {{ (api_url ~ '/api/v1/public/sites/' ~ subdomain ~ '/events')|tojson }};
    function track(type) {
      try {
        var body = JSON.stringify({ event_type: type, path: location.pathname, referrer: document.referrer || null });
        if (navigator.sendBeacon) { navigator.sendBeacon(endpoint, new Blob([body], { type: "text/plain" })); }
        else { fetch(endpoint, { method: "POST", body: body, keepalive: true }); }
      } catch (e) {}
    }
    track("page_view");
    document.addEventListener("click", function (ev) {
      var a = ev.target.closest && ev.target.closest("a");
      if (!a) return;
      if (a.dataset.track) track(a.dataset.track);
      else if (a.getAttribute("href").indexOf("tel:") === 0) track("phone_click");
    });
    document.querySelectorAll("form[data-contact-form]").forEach(function (form) {
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var status = form.querySelector("[data-form-status]");
        fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } })
          .then(function (r) { if (!r.ok) throw new Error(); form.reset(); status.textContent = "Thank you! Your message has been sent."; })
          .catch(function () { status.textContent = "Sorry, something went wrong. Please call or email us instead."; });
      });
    });
  })();
  </script>

  {% if chat %}
  <div class="chat" data-chat data-endpoint="{{ api_url }}/api/v1/public/sites/{{ subdomain }}/chat" data-greeting="{{ chat.get('greeting', '') }}">
    <button class="chat__toggle btn" type="button" aria-expanded="false" aria-controls="chat-panel">Chat with us</button>
    <section class="chat__panel card" id="chat-panel" hidden aria-label="Chat with {{ business.name }}">
      <header class="chat__header"><strong>{{ business.name }}</strong><button type="button" class="chat__close" aria-label="Close chat">&times;</button></header>
      <div class="chat__log" data-chat-log role="log" aria-live="polite"></div>
      <form class="chat__form" data-chat-form>
        <label class="hp" for="chat-input">Message</label>
        <input id="chat-input" name="message" maxlength="1000" autocomplete="off" placeholder="Ask a question..." required>
        <button class="btn btn--small" type="submit">Send</button>
      </form>
      <p class="chat__note muted">Automated assistant. Answers come from this website's information.</p>
    </section>
  </div>
  {% endif %}

  {% if chat or has_booking %}{# widget JS only where a widget exists #}
  <script>
  (function () {
    function post(url, body) {
      return fetch(url, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); });
    }
    // --- Booking widget ---
    var booking = document.querySelector("form[data-booking]");
    if (booking) {
      var base = booking.dataset.endpoint, status = booking.querySelector("[data-booking-status]");
      var slotsBox = booking.querySelector("[data-slots]"), dateInput = booking.elements.date, serviceSel = booking.elements.service;
      fetch(base).then(function (r) { if (!r.ok) throw r; return r.json(); }).then(function (info) {
        info.services.forEach(function (s) {
          var o = document.createElement("option"); o.value = s.name; o.textContent = s.name + " (" + s.duration_minutes + " min)"; serviceSel.appendChild(o);
        });
        var today = new Date(); dateInput.min = today.toISOString().slice(0, 10);
        dateInput.max = new Date(today.getTime() + info.max_days_ahead * 864e5).toISOString().slice(0, 10);
        booking.hidden = false;
      }).catch(function () {});
      function loadSlots() {
        booking.elements.start.value = "";
        if (!dateInput.value) return;
        slotsBox.textContent = "Loading...";
        fetch(base + "/slots?date=" + dateInput.value + "&service=" + encodeURIComponent(serviceSel.value))
          .then(function (r) { return r.json(); }).then(function (slots) {
            slotsBox.textContent = "";
            if (!slots.length) { slotsBox.textContent = "No times available on this day."; return; }
            slots.forEach(function (s) {
              var b = document.createElement("button"); b.type = "button"; b.className = "slot"; b.textContent = s.label;
              b.addEventListener("click", function () {
                slotsBox.querySelectorAll(".slot").forEach(function (x) { x.setAttribute("aria-pressed", "false"); });
                b.setAttribute("aria-pressed", "true"); booking.elements.start.value = s.start;
              });
              slotsBox.appendChild(b);
            });
          }).catch(function () { slotsBox.textContent = "Could not load times. Please call us instead."; });
      }
      dateInput.addEventListener("change", loadSlots); serviceSel.addEventListener("change", loadSlots);
      booking.addEventListener("submit", function (ev) {
        ev.preventDefault();
        if (!booking.elements.start.value) { status.textContent = "Please choose a time."; return; }
        var f = booking.elements;
        post(base, { service: f.service.value, start: f.start.value, name: f.name.value, email: f.email.value || null,
                     phone: f.phone.value || null, notes: f.notes.value || null, website: f.website.value || null })
          .then(function (d) { booking.reset(); slotsBox.textContent = ""; status.textContent = d.message; })
          .catch(function (e) { status.textContent = (e && e.detail && typeof e.detail === "string") ? e.detail : "Sorry, that didn't work. Please try another time or call us."; if (e && e.error === "slot_taken") loadSlots(); });
      });
    }
    // --- Chat widget ---
    var chat = document.querySelector("[data-chat]");
    if (chat) {
      var panel = chat.querySelector(".chat__panel"), toggle = chat.querySelector(".chat__toggle"), log = chat.querySelector("[data-chat-log]");
      var form = chat.querySelector("[data-chat-form]"), key = "gw_chat_" + location.pathname.split("/")[1];
      function bubble(text, who) { var p = document.createElement("p"); p.className = "chat__msg chat__msg--" + who; p.textContent = text; log.appendChild(p); log.scrollTop = log.scrollHeight; }
      function setOpen(open) { panel.hidden = !open; toggle.setAttribute("aria-expanded", String(open)); if (open) { form.elements.message.focus(); if (!log.childElementCount && chat.dataset.greeting) bubble(chat.dataset.greeting, "bot"); } }
      toggle.addEventListener("click", function () { setOpen(panel.hidden); });
      chat.querySelector(".chat__close").addEventListener("click", function () { setOpen(false); });
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var text = form.elements.message.value.trim(); if (!text) return;
        bubble(text, "me"); form.elements.message.value = "";
        var token = null; try { token = sessionStorage.getItem(key); } catch (e) {}
        post(chat.dataset.endpoint, { message: text, session_token: token })
          .then(function (d) { try { sessionStorage.setItem(key, d.session_token); } catch (e) {} bubble(d.reply, "bot"); })
          .catch(function () { bubble("Sorry, the assistant is unavailable right now. Please use the contact form.", "bot"); });
      });
    }
  })();
  </script>
  {% endif %}
</body>
</html>
