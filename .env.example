# Copy to .env (docker compose) or backend/.env (local uvicorn). Never commit real secrets.

# --- Core
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Data stores
POSTGRES_USER=gumaweb
POSTGRES_PASSWORD=gumaweb
POSTGRES_DB=gumaweb
DATABASE_URL=postgresql+psycopg://gumaweb:gumaweb@localhost:5432/gumaweb
REDIS_URL=redis://localhost:6379/0

# --- Public URLs
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
SITE_URL_TEMPLATE=http://localhost:8080/{subdomain}/
PUBLIC_SITE_DOMAIN=gumaweb.io

# --- Storage (local | s3). For MinIO: STORAGE_BACKEND=s3, S3_ENDPOINT_URL=http://localhost:9000
STORAGE_BACKEND=local
S3_BUCKET=gumaweb-sites
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email (console | smtp). Mailpit UI: http://localhost:8025
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=GumaWeb <hello@gumaweb.io>

# --- Bootstrap admin (change immediately)
FIRST_ADMIN_EMAIL=admin@gumaweb.io
FIRST_ADMIN_PASSWORD=ChangeMe!2026

# --- AI (Phase 2; disabled in the MVP)
AI_ENABLED=false
LLM_BASE_URL=http://localhost:8001/v1
LLM_PRIMARY_MODEL=qwen2.5-14b-instruct
LLM_SECONDARY_MODEL=deepseek-r1-distill-qwen-14b
EMBEDDING_MODEL=BAAI/bge-m3
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Automation, voice receptionist and integrations (Phase 4)
# Shared secret for the telephony gateway (Asterisk/ASR/TTS adapter); empty disables /api/v1/voice/*
VOICE_GATEWAY_TOKEN=
# Allow webhooks to private/loopback addresses (local testing only; never in production)
WEBHOOK_ALLOW_PRIVATE=false

# --- Live business discovery (OpenStreetMap is free; Google needs a billing-enabled Places API key)
GOOGLE_MAPS_API_KEY=
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter   # or a mirror, e.g. https://overpass.kumi.systems/api/interpreter
# DISCOVERY_USER_AGENT=GumaWebBot/1.0 (+https://gumaweb.io/bot)
# DISCOVERY_QUERY_DELAY_SECONDS=1.5   # pause between campaign queries (Overpass fair use)
# DISCOVERY_ALLOW_FIXTURE=          # fictional test listings; defaults to on everywhere except production

# --- Contact enrichment (website scrape is free and always on)
ENRICH_AFTER_DISCOVERY=true
ENRICH_ALLOW_RDAP=false             # free, but tells a registry which domains you look at
HUNTER_API_KEY=
ENRICH_ALLOW_HUNTER=false           # a key alone never turns on the paid tier
ENRICH_PAID_MIN_SCORE=80
# HUNTER_COST_MICROS=0              # your plan's price per request in millionths, for the provider_usage ledger

# --- Outbound dialer (parked: docs/OUTREACH_DIALER_BRIDGE_PLAN.md). Only "none" until GumaDial ships its API.
DIALER_PROVIDER=none

# --- Outbound engine (docs/OUTBOUND_ENGINE_PLAN.md)
AUTO_COMPILE_ENABLED=false          # generate + publish sites for qualifying discovered businesses, unattended
AUTO_COMPILE_DAILY_LIMIT=50         # new auto sites per day (Philippine time); manual batches do not count

# --- Phase 5: custom domains and business email
CUSTOM_DOMAIN_CNAME_TARGET=domains.gumaweb.io
# CUSTOM_DOMAIN_IPV4=203.0.113.10
MAIL_PROVIDER=disabled            # stalwart once the mail server is bootstrapped
STALWART_USERNAME=admin
STALWART_SECRET=
MAIL_CLIENT_HOST=mail.gumaweb.test

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Host ports for docker compose (change if they clash with other local projects)
GW_PORTAL_PORT=3000
GW_API_PORT=8000
GW_SITES_PORT=8080
GW_POSTGRES_PORT=5432
GW_REDIS_PORT=6379
GW_MAILPIT_PORT=8025
GW_SMTP_PORT=1025
